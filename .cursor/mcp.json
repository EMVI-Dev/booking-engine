{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "chrome-devtools": {
            "command": "/Users/mastervarol/Library/Application Support/Herd/config/nvm/versions/node/v22.23.2/bin/npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest",
                "--acceptInsecureCerts"
            ]
        },
        "tailwindcss": {
            "command": "/Users/mastervarol/Library/Application Support/Herd/config/nvm/versions/node/v22.23.2/bin/npx",
