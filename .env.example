APP_NAME=TravelEngine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# false = marketing site only; operator log in and sign-up are closed
REGISTRATION_ENABLED=false

# true = pause operator sign-up and all storefront bookings/payments (not artisan down)
PLATFORM_MAINTENANCE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=booking
DB_USERNAME=root
DB_PASSWORD=

ADMIN_EMAIL=admin@travelengine.online
ADMIN_PASSWORD=

# Public demo operator at demo.{platform-domain}. Required in production.
DEMO_OPERATOR_EMAIL=demo@travelengine.online
DEMO_OPERATOR_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# public = local disk. r2 = Cloudflare R2 (S3 API) when API credentials are set.
MEDIA_DISK=public
MEDIA_WEBP_QUALITY=80
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=https://storage.travelengine.online
R2_REGION=auto

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@travelengine.online"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Lightsail origin. Apex travelengine.online is on Cloudflare; slugs are DNS-only.
# Agency CNAME to a grey hostname, or A / AAAA the apex here.
PLATFORM_PUBLIC_IPV4=
PLATFORM_PUBLIC_IPV6=

# Caddy on-demand TLS. ask http://127.0.0.1/internal/caddy/ask?token=…
# An empty token refuses every host.
CADDY_ASK_TOKEN=

# Incoming webhook for operator registration, plan changes, and status.
# Leave empty to disable.
SLACK_OPERATOR_WEBHOOK_URL=

# Checkout, refunds, and payouts use client_id + secret (HMAC).
# Never enable the simulator next to live keys.
DOKU_MODE=sandbox
DOKU_SIMULATOR_ENABLED=false
DOKU_SANDBOX_CLIENT_ID=
DOKU_SANDBOX_SECRET_KEY=
DOKU_SANDBOX_BASE_URL=https://api-sandbox.doku.com
DOKU_SANDBOX_CHECKOUT_URL=https://jokul-sandbox.doku.com/checkout
DOKU_LIVE_CLIENT_ID=
DOKU_LIVE_SECRET_KEY=
DOKU_LIVE_BASE_URL=https://api.doku.com
DOKU_LIVE_CHECKOUT_URL=https://jokul.doku.com/checkout
