# ==========================================================================
# TravelEngine environment
#
# Two kinds of values live here:
#   1. GENERAL    per-environment settings, safe to share with the team.
#   2. SECRETS    keys, passwords and tokens. Leave them empty in this file.
#                 Production: set them in Laravel Cloud (environment variables
#                 or Secrets Manager). Local: put them only in your own .env,
#                 which is git-ignored. Never put a secret in config/*.php or
#                 any committed file.
#
# Everything not listed here has a sensible default in config/*.php.
# Full list with production values: docs/engineering/production-launch.md
# ==========================================================================

# --------------------------------------------------------------------------
# 1. GENERAL
# --------------------------------------------------------------------------
APP_NAME=TravelEngine
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar
LOG_LEVEL=debug

# Comma-separated proxy IPs, or * on Laravel Cloud (only reachable through its edge).
TRUSTED_PROXIES=

# true = pause operator sign-up and all storefront bookings/payments (not artisan down).
# This is the only sign-up switch; Admin -> Settings can flip it too.
PLATFORM_MAINTENANCE=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travelengine
DB_USERNAME=root

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="no-reply@travelengine.id"
MAIL_FROM_NAME="${APP_NAME}"

# First platform admin and the public demo shop (logins only; passwords are secrets).
ADMIN_EMAIL=admin@travelengine.id
DEMO_OPERATOR_EMAIL=demo@travelengine.id

# Media: public (local disk) or r2 (Cloudflare R2, production).
MEDIA_DISK=public
R2_BUCKET=
R2_ENDPOINT=
R2_URL=https://storage.travelengine.id

# Payments: sandbox or live. The simulator is never on next to live keys.
DOKU_MODE=sandbox
DOKU_SIMULATOR_ENABLED=false

# Agency website addresses: empty = laravel_cloud in production, local elsewhere.
CUSTOM_DOMAIN_PROVIDER=
LARAVEL_CLOUD_ENVIRONMENT_ID=

# Google Maps Embed key (public; enable only the Maps Embed API). Shows the Google
# listing card on Agency storefronts and in Reviews settings. Empty = buttons only.
GOOGLE_MAPS_EMBED_KEY=

# Platform Google Analytics 4 (marketing and sign-in pages only). Empty = no tracking.
PLATFORM_GOOGLE_ANALYTICS_ID=

# --------------------------------------------------------------------------
# 2. SECRETS (leave empty here; set in Laravel Cloud or your own local .env)
# --------------------------------------------------------------------------
APP_KEY=
DB_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_PASSWORD=
DEMO_OPERATOR_PASSWORD=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
DOKU_SANDBOX_CLIENT_ID=
DOKU_SANDBOX_SECRET_KEY=
DOKU_LIVE_CLIENT_ID=
DOKU_LIVE_SECRET_KEY=
LARAVEL_CLOUD_API_TOKEN=
GOOGLE_PLACES_API_KEY=
SLACK_OPERATOR_WEBHOOK_URL=
